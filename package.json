{
    "name": "camoufox-mcp-server",
    "version": "2.6.0",
    "description": "MCP server for browser automation using Camoufox - a privacy-focused Firefox fork with advanced anti-detection features",
    "keywords": [
        "mcp",
        "camoufox",
        "browser",
        "automation",
        "anti-detection",
        "fingerprint",
        "spoofing",
        "modelcontextprotocol"
    ],
    "author": "followthewhit3rabbit",
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "camoufox-mcp-server": "dist/index.js",
        "camoufox-mcp-fetch": "scripts/fetch-browser.mjs",
        "camoufox-mcp-doctor": "scripts/doctor.mjs"
    },
    "files": [
        "dist/**/*",
        "scripts/fetch-browser.mjs",
        "docs/**/*",
        "plugins/camoufox/.claude-plugin/**/*",
        "plugins/camoufox/.codex-plugin/**/*",
        "plugins/camoufox/.mcp.json",
        "plugins/camoufox/openclaw.plugin.json",
        "plugins/camoufox/package.json",
        "plugins/camoufox/skills/camoufox/SKILL.md",
        "plugins/camoufox/skills/camoufox/agents/**/*",
        "plugins/camoufox/skills/camoufox/references/**/*",
        ".claude-plugin/**/*",
        ".agents/plugins/**/*",
        "README.md",
        "LICENSE",
        "browser-builds.json",
        "scripts/doctor.mjs"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/whit3rabbit/camoufox-mcp.git"
    },
    "bugs": {
        "url": "https://github.com/whit3rabbit/camoufox-mcp/issues"
    },
    "homepage": "https://github.com/whit3rabbit/camoufox-mcp#readme",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "rimraf dist && tsc",
        "start": "node dist/index.js",
        "dev": "tsc --watch",
        "lint": "eslint src/",
        "fetch:camoufox": "node scripts/fetch-browser.mjs",
        "doctor": "node scripts/doctor.mjs",
        "test": "npm run test:local",
        "test:unit": "npm run build && node tests/unit_policy.mjs && node tests/unit_private_host_errors.mjs && node tests/unit_navigation.mjs && node tests/unit_sequence.mjs && node tests/unit_snapshot.mjs && node tests/unit_sqlite_shim.mjs && node tests/unit_browser_preflight.mjs && node tests/unit_browser_compatibility.mjs && node tests/unit_browser_fetch.mjs",
        "test:local": "npm run build && PYTHONDONTWRITEBYTECODE=1 python3 tests/test_client.py --mode local",
        "test:camoufox": "npm run fetch:camoufox && npm run test:local",
        "test:docker": "./tests/run_tests.sh",
        "test:all": "npm run lint && npm audit && npm run test:unit && npm run fetch:camoufox && npm run test:local"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "camoufox-js": "0.12.0",
        "chalk": "^5.6.2",
        "playwright-core": "1.59.0",
        "zod": "^4.4.3"
    },
    "optionalDependencies": {
        "@camoufox/camoufox": "0.5.7-beta.4"
    },
    "overrides": {
        "adm-zip": "^0.6.0",
        "js-yaml": "4.3.2",
        "playwright-core": "1.59.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.7.0",
        "eslint": "^10.3.0",
        "jest": "^30.4.2",
        "rimraf": "^6.1.3",
        "ts-jest": "^29.4.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.3"
    }
}
